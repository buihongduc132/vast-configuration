# vitest is pinned to an EXACT version (3.2.7) in package.json, not a ^range.
#
# Why: npm 10.9.7's arborist crashes with
#   TypeError: Cannot read properties of null (reading 'edgesOut')
#   at #loadPeerSet (build-ideal-tree.js:1289)
# while resolving the peer set of vitest 4.x on this machine. It is reproducible
# in an empty /tmp directory, so it is an npm/arborist bug, not a repo problem.
#
# Pinning 3.2.7 avoids the failing resolution path entirely, so a plain
# `npm install` works with no extra flags. If you must use vitest 4.x, install
# with `--legacy-peer-deps` (also verified working).
save-exact=true
